# Server-side configuration for the web authentication handlers.
# scripts/configure_local.py writes ignored .env.local for local Supabase.
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=REPLACE_LOCALLY
WINE_JOURNAL_API_URL=http://127.0.0.1:8000
WINE_JOURNAL_SITE_URL=http://localhost:3000
# Enable only after provider registration and Supabase configuration are verified.
WINE_JOURNAL_OAUTH_PROVIDERS=
# Intended supported values: google,apple,facebook (comma-separated).
# No OAuth client secret or Supabase secret/service-role key belongs in this app.
# NEXT_PUBLIC_* is visible to anyone; it is never a secret store.
