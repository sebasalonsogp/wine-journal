# Copy only public configuration; scripts/configure_local.py generates local passwords.
# JSON list; match the browser's exact origin.
WINE_JOURNAL_CORS_ORIGINS=["http://localhost:3000"]
WINE_JOURNAL_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
# Keep disabled until the M03 photo processor is available. Separate .env.storage holds its key.
WINE_JOURNAL_MEDIA_UPLOADS_ENABLED=false
# WINE_JOURNAL_DATABASE_URL=postgresql+psycopg://wine_api:REPLACE_LOCALLY@127.0.0.1:54322/postgres
# Migration credentials belong in .env.migrations, never this API runtime file.
# Remote database URLs must use sslmode=verify-full and the provider's CA when required.
